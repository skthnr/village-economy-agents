{
  "name": "eidolon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "orchestrator",
    "relayer"
  ],
  "scripts": {
    "test": "node --import=tsx --test tests/*.test.ts",
    "test:relayer": "node --import=tsx --test tests/relayer.test.ts",
    "test:simulation": "node --import=tsx --test tests/simulation.test.ts",
    "demo": "node --import=tsx demo.mjs",
    "measure": "node --import=tsx scripts/measure.mjs",
    "variants": "node scripts/variants.mjs",
    "start:relayer": "node --env-file=.env --import=tsx relayer/src/server.ts",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit -p orchestrator/tsconfig.json && node node_modules/typescript/lib/tsc.js --noEmit -p relayer/tsconfig.json",
    "typecheck:relayer": "node node_modules/typescript/lib/tsc.js --noEmit -p relayer/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "near-api-js": "7.5.3",
    "near-sandbox": "0.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.18.0"
  }
}
